# Sistema Comedor - Aluminios del Uruguay
# Copiá este archivo a .env y completá los valores

# ── Seguridad ────────────────────────────────────────────────────────────────
# Generá una clave segura con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esto-por-una-clave-secreta-larga-y-aleatoria
ACCESS_TOKEN_EXPIRE_HOURS=8

# ── Base de datos local (SQLite) ─────────────────────────────────────────────
# La ruta es relativa al WORKDIR del contenedor (/app/backend)
DATABASE_URL=sqlite:///./data/comedor.db
