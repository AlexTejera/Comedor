# Sistema Comedor - Aluminios del Uruguay
# Copiá este archivo a .env y completá los valores

# ── Seguridad ────────────────────────────────────────────────────────────────
# Generá una clave segura con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esto-por-una-clave-secreta-larga-y-aleatoria
ACCESS_TOKEN_EXPIRE_HOURS=8

# ── Base de datos local (SQLite) ─────────────────────────────────────────────
# La ruta es relativa al WORKDIR del contenedor (/app/backend)
DATABASE_URL=sqlite:///./data/comedor.db

# ── Prefijo de ruta del WAF (DMZ) ─────────────────────────────────────────────
# Si el WAF expone el sitio como https://aluminios.com.uy/comedor y reenvía
# la request con el prefijo incluido (no lo recorta), dejar "/comedor". El
# acceso interno directo (sin WAF) sigue funcionando igual sin cambios.
# Vacío ("") desactiva este soporte.
WAF_PATH_PREFIX=/comedor
